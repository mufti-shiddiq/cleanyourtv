<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="84dp" android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/btnLibrary" style="@style/TopButton"
        android:text="@string/app_library"
        android:drawableStart="@drawable/ic_apps_pill" />
    <!-- stats_below_library: the show_stats line, set by AppAdapter.setStatsLine. -->
    <TextView android:id="@+id/libraryStats"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:layout_marginBottom="12dp"
        android:singleLine="true" android:textColor="#D9FFFFFF" android:textSize="14sp"
        android:fontFamily="@string/font_medium" android:letterSpacing="0.04" android:focusable="false"
        android:visibility="gone" />
</LinearLayout>
